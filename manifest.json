{
  "manifest_version": 3,
  "name": "ChatGPT & Claude Exporter – PDF & Markdown",
  "version": "1.0.0",
  "description": "Export AI conversations to Markdown, JSON, Text and PDF",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "downloads",
    "contextMenus",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://grok.com/*",
    "https://chat.deepseek.com/*",
    "https://gemini.google.com/*",
    "https://chat.qwen.ai/*",
    "https://chat.qwenlm.ai/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://chat.mistral.ai/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://gemini.google.com/*",
        "https://chat.qwen.ai/*",
        "https://chat.qwenlm.ai/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://chat.mistral.ai/*"
      ],
      "js": [
        "dist/in-page.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_popup": "dist/popup.html",
    "default_title": "Export this conversation",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "short_name": "AI Chat Exporter",
  "minimum_chrome_version": "120"
}
